# Copie para .env e ajuste. Nunca versione o arquivo .env.
# Os valores abaixo são apenas demonstrativos.

# Banco de desenvolvimento
DATABASE_URL=postgresql+psycopg://lotofacil_app:troque_esta_senha@localhost:5432/lotofacil

# Banco exclusivo dos testes de integração (o nome DEVE terminar em _test)
TEST_DATABASE_URL=postgresql+psycopg://lotofacil_app:troque_esta_senha@localhost:5432/lotofacil_test

# Pool de conexões e tempo limite (segundos)
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT=5

# Ambiente: desenvolvimento | teste | producao
APP_ENV=desenvolvimento
LOG_LEVEL=INFO

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
